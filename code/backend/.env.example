# Database Configuration
# Gunakan SQLite untuk development lokal sederhana, atau PostgreSQL untuk production
DATABASE_URL=sqlite:///./scheduler.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduler_db

# App Settings
PROJECT_NAME="STI Course Scheduler"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Solver Settings
SOLVER_TIME_LIMIT_SECONDS=300
SOLVER_WORKERS=8
